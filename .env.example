# Copiar a `.env` y ajustar los valores.

# Cadena de conexión a PostgreSQL.
# Con `docker compose up -d` este valor funciona tal cual.
DATABASE_URL="postgresql://sabor:sabor@localhost:5433/sabor_gourmet?schema=public"

# Clave que protege el panel de administración.
ADMIN_ACCESS_KEY="cambiar-esta-clave"

# development | production
APP_ENV="development"
